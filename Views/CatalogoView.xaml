<UserControl x:Class="GreenStock.Views.CatalogoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GreenStock.Views" xmlns:viewmodels="clr-namespace:GreenStock.ViewModels" xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             mc:Ignorable="d" 
             d:DesignHeight="1080" d:DesignWidth="1920">

    <UserControl.Resources>
        <viewmodels:CatalogoViewModel x:Key="catalogo"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid Background="#fff"
      DataContext="{Binding Source={StaticResource catalogo}}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical" Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <fa:IconImage Margin="0, 0, 8, 0" Icon="Tag" Width="38" Height="38"/>
                    <TextBlock Text="Catalogo" FontSize="24" FontWeight="Bold" />
                </StackPanel>
                <TextBlock Text="Gestiona las categorias y marcas de tus eproductos" FontSize="14" Foreground="gray"/>
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="10">
            <Button Padding="15,0"
                    Background="#38C172"  Foreground="White"
                    BorderBrush="Transparent"
                    HorizontalAlignment="Right"
                    Content="CATEGORIAS"
                    Command="{Binding OpenCategoryView}"/>
            <Button Padding="15,0"
                    Background="#38C172"  Foreground="White"
                    BorderBrush="Transparent"
                    HorizontalAlignment="Left"
                    Content="MARCAS"
                    Command="{Binding OpenBrandView}" />
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="#000" BorderThickness=".5" Margin="10" CornerRadius="10"
                Visibility="{Binding IsCategoryViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Margin="10">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Categorias" FontSize="24" FontWeight="Bold" 
                       VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                    Padding="15,0"
                    Background="#38C172"  Foreground="White"
                    BorderBrush="Transparent"
                    Content="+ Nueva Categoria"
                    Command="{Binding OpenAddCategoryModal}"/>
                </Grid>

                <ListBox ItemsSource="{Binding Categories}" 
                     SelectedItem="{Binding SelectedCategory}"
                     Margin="0"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" IsItemsHost="True" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="10"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E6F2FF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="300" Height="120" 
                                BorderBrush="#DDDDDD" 
                                BorderThickness="2" 
                                CornerRadius="10" 
                                Background="White">
                                <Grid Margin="15">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" CornerRadius="3" Padding="8,2" HorizontalAlignment="Left"
                                            MaxWidth="180">
                                            <TextBlock Text="{Binding Name}" 
                                                   Foreground="Black" 
                                                   FontWeight="SemiBold" 
                                                   TextTrimming="CharacterEllipsis"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="✏" Margin="0,0,5,0"
                                                Command="{Binding DataContext.OpenUpdateCategoryModal, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBox}}}"
                                                CommandParameter="{Binding}" />
                                            <Button Content="🗑" 
                                                Command="{Binding DataContext.DeleteCategory, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBox}}}"
                                                CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Grid.Row="1" Text="{Binding Description}" 
                                           Foreground="#555555" 
                                           Margin="15,20,0,10"
                                           TextWrapping="Wrap"/>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <TextBlock Text="📦 x productos" Margin="0,0,5,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" BorderBrush="#000" BorderThickness=".5" Margin="10" CornerRadius="10"
                Visibility="{Binding IsBrandViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">


            <StackPanel>

                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Marcas" FontSize="24" FontWeight="Bold" 
                       VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Padding="15,0"
                            Background="#38C172"  Foreground="White"
                            BorderBrush="Transparent"
                            Content="+ Nueva Marca"
                            Command="{Binding OpenAddBrandModal}"/>
                </Grid>

                <DataGrid ItemsSource="{Binding Brands}"
                          SelectedItem="{Binding SelectedBrand, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False" Margin="10 0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Proveedor" Width="auto" Binding="{Binding Name}"/>
                        <DataGridTextColumn Header="Descripcion" Width="auto" Binding="{Binding Description}"/>
                        <DataGridTemplateColumn Header="Editar" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="✏"
                                        Padding="5"
                                        Command="{Binding DataContext.OpenUpdateBrandModal, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type DataGrid}}}"
                                        CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                </DataGrid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="0" Grid.RowSpan="3"
              Background="#99000000"
              Visibility="{Binding AddCategoryModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">

            <Border Width="650" Height="Auto"
                    Background="White"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="25">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Agregar Categoria" FontSize="20" FontWeight="Bold" Foreground="#1E1E1E"/>
                            <TextBlock Text="Registra una nueva categoria de productos" FontSize="13" Foreground="#666666"/>
                        </StackPanel>

                        <Button Content="✕" 
                        Style="{StaticResource CloseButtonStyle}" 
                        Foreground="#333" 
                        Command="{Binding CloseModalCommand}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" 
                        Margin="10, -10, -10, 0"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="Nombre" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Category.Name, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,0,0,15">
                            <TextBlock Text="Descripcion" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Category.Description, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">

                        <Button Content="Cancelar"
                        Command="{Binding CloseModalCommand}"
                        Background="Transparent"
                        Foreground="#333"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        Padding="20,8"
                        Margin="0,0,10,0"/>

                        <Button Content="Crear Categoria"
                        Command="{Binding AddCategory}"
                        Background="#1E1E1E" Foreground="White"
                        BorderBrush="Transparent"
                        Padding="20,8"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="0" Grid.RowSpan="3"
              Background="#99000000"
              Visibility="{Binding UpdateCategoryModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">

            <Border Width="650" Height="Auto"
            Background="White"
            CornerRadius="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Padding="25">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Editar Categoria" FontSize="20" FontWeight="Bold" Foreground="#1E1E1E"/>
                            <TextBlock Text="Actualiza los datos de la categoria" FontSize="13" Foreground="#666666"/>
                        </StackPanel>

                        <Button Content="✕" 
                        Style="{StaticResource CloseButtonStyle}" 
                        Foreground="#333" 
                        Command="{Binding CloseModalCommand}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" 
                        Margin="10, -10, -10, 0"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="Nombre" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Category.Name, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,0,0,15">
                            <TextBlock Text="Descripcion" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Category.Description, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">

                        <Button Content="Cancelar"
                        Command="{Binding CloseModalCommand}"
                        Background="Transparent"
                        Foreground="#333"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        Padding="20,8"
                        Margin="0,0,10,0"/>

                        <Button Content="Actualizar"
                        Command="{Binding UpdateCategory}"
                        Background="#1E1E1E" Foreground="White"
                        BorderBrush="Transparent"
                        Padding="20,8"
                        Margin="0,0,10,0"/>

                        <Button Content="Eliminar"
                        Command="{Binding DeleteCategory}"
                        CommandParameter="{Binding SelectedCategory}" 
                        Background="Transparent"
                        Foreground="#333"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        Padding="20,8"/>

                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="0" Grid.RowSpan="3"
              Background="#99000000"
              Visibility="{Binding AddBrandModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">

            <Border Width="650"  Height="Auto"
                    Background="White"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="25">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Agregar Nueva Marca" FontSize="20" FontWeight="Bold" Foreground="#1E1E1E"/>
                            <TextBlock Text="Registra una nueva marca de productos" FontSize="13" Foreground="#666666"/>
                        </StackPanel>

                        <Button Content="✕" 
                                Style="{StaticResource CloseButtonStyle}"  
                                Foreground="#333" 
                                Command="{Binding CloseModalCommand}"
                                HorizontalAlignment="Right" VerticalAlignment="Top" 
                                Margin="10, -10, -10, 0"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,15">
                            <TextBlock Text="Nombre" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Brand.Name, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,15">
                            <TextBlock Text="Descripcion" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Brand.Description, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">

                        <Button Content="Cancelar"
                                Command="{Binding CloseModalCommand}"
                                Background="Transparent"
                                Foreground="#333"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                Padding="20,8"
                                Margin="0,0,10,0"/>

                        <Button Content="Crear Marca"
                                Command="{Binding AddBrand}"
                                Background="#1E1E1E"  Foreground="White"
                                BorderBrush="Transparent"
                                Padding="20,8"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#99000000"
                Visibility="{Binding UpdateBrandModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">

            <Border Width="650"  Height="Auto"
                    Background="White"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="25">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Editar Proveedor" FontSize="20" FontWeight="Bold" Foreground="#1E1E1E"/>
                            <TextBlock Text="Actualiza o elimina los datos del proveedor" FontSize="13" Foreground="#666666"/>
                        </StackPanel>

                        <Button Content="✕" 
                        Style="{StaticResource CloseButtonStyle}"  
                        Foreground="#333" 
                        Command="{Binding CloseModalCommand}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" 
                        Margin="10, -10, -10, 0"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,15">
                            <TextBlock Text="Nombre" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Brand.Name, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0">
                            <TextBlock Text="Descripcion" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Brand.Description, Mode=TwoWay}" Padding="20"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>

                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">

                        <Button Content="Cancelar"
                        Command="{Binding CloseModalCommand}"
                        Background="Transparent"
                        Foreground="#333"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        Padding="20,8"
                        Margin="0,0,10,0"/>

                        <Button Content="Editar"
                        Command="{Binding UpdateBrand}"
                        Background="Transparent"
                        Foreground="#333"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        Padding="20,8"
                        Margin="0,0,10,0"/>

                        <Button Content="Eliminar"
                        Command="{Binding DeleteBrand}"
                        Background="Transparent"
                        Foreground="#333"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        Padding="20,8"
                        Margin="0,0,10,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    
</UserControl>
