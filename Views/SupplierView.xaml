<UserControl x:Class="GreenStock.Views.SupplierView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GreenStock.Views"
             xmlns:viewmodels="clr-namespace:GreenStock.ViewModels" xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             mc:Ignorable="d" 
             d:DesignHeight="1080" d:DesignWidth="1920">
    
    <UserControl.Resources>
        <viewmodels:SupplierViewModel x:Key="suppliers"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="#fff"
           DataContext="{Binding Source={StaticResource suppliers}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical" Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <fa:IconImage Margin="0, 0, 8, 0" Icon="Truck" Width="38" Height="38"/>
                    <TextBlock Text="Proveedores" FontSize="24" FontWeight="Bold"/>
                </StackPanel>

                <TextBlock Text="Gestiona la información de tus proveedores" FontSize="14" Foreground="Gray"/>
            </StackPanel>

            <Button Content="+ Nuevo Proveedor"
                    Grid.Column="1"
                    Padding="15,0"
                    Background="#38C172"  Foreground="White"
                    BorderBrush="Transparent"
                    HorizontalAlignment="Right"
                    Command="{Binding OpenModalCommand}"/>
        </Grid>

        <StackPanel Grid.Row="2" Margin="10">
            
            <TextBlock Text="Proveedores" FontWeight="SemiBold" Margin="0,0,0,5"/>
            
            <DataGrid ItemsSource="{Binding Suppliers}"
                      SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Proveedor" Width="auto" Binding="{Binding Name}"/>
                    <DataGridTextColumn Header="Descripcion" Width="auto" Binding="{Binding Description}"/>
                    <DataGridTextColumn Header="CUIT" Width="auto" Binding="{Binding Cuit}"/>
                    <DataGridTextColumn Header="Telefono" Width="auto" Binding="{Binding Phone}"/>
                    <DataGridTextColumn Header="Email" Width="auto" Binding="{Binding Email}"/>
                    <DataGridTextColumn Header="Note" Width="auto" Binding="{Binding Notes}"/>
                    <DataGridTemplateColumn Header="Editar" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="✏"
                                            Padding="5"
                                            Command="{Binding DataContext.OpenUpdateModalCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type DataGrid}}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>

            </DataGrid>
        </StackPanel>

        <Grid Grid.Row="0" Grid.RowSpan="3"
              Background="#99000000"
              Visibility="{Binding IsModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">

            <Border Width="650"  Height="Auto"
            Background="White"
            CornerRadius="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Padding="25">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Agregar Nuevo Proveedor" FontSize="20" FontWeight="Bold" Foreground="#1E1E1E"/>
                            <TextBlock Text="Completa los datos del proveedor" FontSize="13" Foreground="#666666"/>
                        </StackPanel>

                        <Button Content="✕" 
                        Style="{StaticResource CloseButtonStyle}"  
                        Foreground="#333" 
                        Command="{Binding CloseModalCommand}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" 
                        Margin="10, -10, -10, 0"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,15">
                            <TextBlock Text="Nombre" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Supplier.Name, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,15">
                            <TextBlock Text="Email" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Supplier.Email, Mode=TwoWay}"/>
                        </StackPanel>


                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,15">
                            <TextBlock Text="CUIT" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Supplier.Cuit, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,15">
                            <TextBlock Text="Teléfono" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Supplier.Phone, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0">
                            <TextBlock Text="Descripcion" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Supplier.Description, Mode=TwoWay}" Padding="20"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>

                        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0">
                            <TextBlock Text="Notas" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Supplier.Notes, Mode=TwoWay}" Padding="40"
                             VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">

                        <Button Content="Cancelar"
                        Command="{Binding CloseModalCommand}"
                        Background="Transparent"
                        Foreground="#333"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        Padding="20,8"
                        Margin="0,0,10,0"/>

                        <Button Content="Agregar Proveedor"
                        Command="{Binding AddSupplierCommand}"
                        Background="#1E1E1E"  Foreground="White"
                        BorderBrush="Transparent"
                        Padding="20,8"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="0" Grid.RowSpan="3"
              Background="#99000000"
              Visibility="{Binding IsUpdateModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">

            <Border Width="650"  Height="Auto"
                    Background="White"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="25">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Editar Proveedor" FontSize="20" FontWeight="Bold" Foreground="#1E1E1E"/>
                            <TextBlock Text="Actualiza o elimina los datos del proveedor" FontSize="13" Foreground="#666666"/>
                        </StackPanel>

                        <Button Content="✕" 
                                Style="{StaticResource CloseButtonStyle}"  
                                Foreground="#333" 
                                Command="{Binding CloseModalCommand}"
                                HorizontalAlignment="Right" VerticalAlignment="Top" 
                                Margin="10, -10, -10, 0"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,15">
                            <TextBlock Text="Nombre" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Supplier.Name, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,15">
                            <TextBlock Text="Email" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Supplier.Email, Mode=TwoWay}"/>
                        </StackPanel>


                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,15">
                            <TextBlock Text="CUIT" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Supplier.Cuit, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,15">
                            <TextBlock Text="Teléfono" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Supplier.Phone, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0">
                            <TextBlock Text="Descripcion" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Supplier.Description, Mode=TwoWay}" Padding="20"
                             VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>

                        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0">
                            <TextBlock Text="Notas" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Supplier.Notes, Mode=TwoWay}" Padding="40"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">

                        <Button Content="Cancelar"
                                Command="{Binding CloseModalCommand}"
                                Background="Transparent"
                                Foreground="#333"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                Padding="20,8"
                                Margin="0,0,10,0"/>

                        <Button Content="Editar"
                                Command="{Binding UpdateSupplierCommand}"
                                Background="Transparent"
                                Foreground="#333"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                Padding="20,8"
                                Margin="0,0,10,0"/>

                        <Button Content="Eliminar"
                                Command="{Binding DeleteSupplierCommand}"
                                Background="Transparent"
                                Foreground="#333"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                Padding="20,8"
                                Margin="0,0,10,0"/>

                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        
    </Grid>
</UserControl>
