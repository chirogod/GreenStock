<UserControl x:Class="GreenStock.Views.SaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GreenStock.Views"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp" 
             xmlns:viewmodels="clr-namespace:GreenStock.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="1080" d:DesignWidth="1920">

    <UserControl.Resources>
        <viewmodels:SaleViewModel x:Key="sales"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="#fff" DataContext="{Binding Source={StaticResource sales}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="10">

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconImage Margin="0, 0, 8, 0" Icon="ShoppingCart" Width="38" Height="38"/>
                        <TextBlock Text="Nueva venta" FontSize="24" FontWeight="Bold"/>
                    </StackPanel>

                    <TextBlock Text="Registra tus ventas" FontSize="14" Foreground="Gray"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="#EBF3FF"
                        BorderBrush="#003399"  BorderThickness="1"
                        CornerRadius="5"
                        Padding="10"
                        Grid.Column="0">

                    <StackPanel>
                        <TextBlock Text="Buscar producto por su codigo, nombre, descripcion..."
                                   Foreground="#0052CC"  FontWeight="Bold"
                                   FontSize="16"
                                   Margin="0,0,0,5"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="155*"/>
                                <ColumnDefinition Width="429*"/>
                            </Grid.ColumnDefinitions>

                            <fa:IconImage Icon="Search" 
                                          Grid.Column="0" 
                                          Foreground="#0052CC"
                                          Width="25" Height="25"
                                          VerticalAlignment="Center" 
                                          Margin="0,0,5,0"/>

                            <TextBox FontSize="14"
                                     Padding="5"
                                     Background="White"
                                     BorderBrush="LightGray"
                                     BorderThickness="1"
                                     Height="40"
                                     VerticalContentAlignment="Center"
                                     Grid.ColumnSpan="3" Margin="30,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="#F9F5FF"
                        BorderBrush="#9370DB"  BorderThickness="1"
                        CornerRadius="5"
                        Padding="10"
                        Grid.Column="2">

                    <StackPanel>
                        <TextBlock Text="Escáner de Código de Barras"
                                   Foreground="#9370DB"  FontWeight="Bold"
                                   FontSize="16"
                                   Margin="0,0,0,5"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="|||||" 
                                        Grid.Column="0" 
                                        Foreground="#9370DB" 
                                        FontSize="20" 
                                        VerticalAlignment="Center" 
                                        Margin="0,0,5,0"/>

                            <TextBox Grid.Column="1"
                                     FontSize="14"
                                     Padding="5"
                                     Background="White"
                                     BorderBrush="LightGray"
                                     BorderThickness="1"
                                     Height="40"
                                     VerticalContentAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="10,0,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Productos Disponibles"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,10,0,10"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Products}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8"
                                        Background="White"
                                        BorderBrush="#F0F0F0"
                                        BorderThickness="1"
                                        Margin="8"
                                        MinWidth="280"
                                        MaxWidth="340">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="1"
                                      Color="#DDD"
                                      Opacity="0.4"
                                      BlurRadius="8"/>
                                    </Border.Effect>

                                    <Button Padding="15"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Top"
                                            Command="{Binding DataContext.AddToSaleItems, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding}">

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Grid.Row="0" Grid.Column="0"
                                                           Text="{Binding Name}"
                                                           FontSize="16"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Top"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Row="0" Grid.Column="0"
                                                           Text="{Binding Code}"
                                                           FontSize="16"
                                                           FontWeight="Light"
                                                           VerticalAlignment="Top"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            

                                            <Border Grid.Row="0" Grid.Column="1"
                                                    Padding="6,3"
                                                    CornerRadius="4"
                                                    VerticalAlignment="Top"
                                                    HorizontalAlignment="Right">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F0F0F0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Pesable}" Value="False">
                                                                <Setter Property="Background" Value="#2A3B4D"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="10" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Pesable"/>
                                                            <Setter Property="Foreground" Value="#555"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Pesable}" Value="False">
                                                                    <Setter Property="Text" Value="Unitario"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                       Text="{Binding VentaConIva, StringFormat=C0}"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       Margin="0,8,0,0"/>

                                            <StackPanel Grid.Row="2" Grid.Column="0"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Margin="0,15,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Pesable}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <StackPanel Orientation="Horizontal" Cursor="Hand">
                                                    <fa:IconImage Icon="BalanceScale"
                                                                  Foreground="#0052CC"
                                                                  Width="12" Height="12"
                                                                  Margin="0,0,5,0"/>
                                                    <TextBlock Text="Usar balanza"
                                                               Foreground="#0052CC"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock Grid.Row="2" Grid.Column="1"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Margin="0,15,0,0"
                                                       Foreground="Gray"
                                                       FontSize="12"/>
                                        </Grid>
                                    </Button>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>


        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Padding="15">
                <StackPanel>
                    <TextBlock Text="Productos en el Carrito" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ListView ItemsSource="{Binding SaleItems}" Height="Auto">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Codigo" DisplayMemberBinding="{Binding Product.Code}"/>
                                <GridViewColumn Header="Producto" DisplayMemberBinding="{Binding Product.Description}"/>
                                <GridViewColumn Header="Cantidad" DisplayMemberBinding="{Binding Quantity}"/>
                                <GridViewColumn Header="Precio Unitario" DisplayMemberBinding="{Binding SalePrice, StringFormat=C}"/>
                                <GridViewColumn Header="Dcto" DisplayMemberBinding="{Binding Discount}"/>
                                <GridViewColumn Header="Subtotal" DisplayMemberBinding="{Binding Total, StringFormat=C}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </Border>

        </Grid>

        <Grid Grid.Row="0" Grid.RowSpan="3"
              Background="#99000000"
              Visibility="{Binding IsBalanzaModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">

            <Border Width="650"  Height="Auto"
                    Background="White"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="25">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Agregar Producto Pesable" FontSize="20" FontWeight="Bold" Foreground="#1E1E1E"/>
                            <TextBlock Text="Ingresa cuanto pesa el producto" FontSize="13" Foreground="#666666"/>
                        </StackPanel>
                        <Button Content="✕" Style="{StaticResource CloseButtonStyle}" Foreground="#333" Command="{Binding CloseModalCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10, -10, -10, 0"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="1" Margin="0,0,0,15">
                            <TextBlock Text="Balanza" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding BalanzaWeight, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Command="{Binding CloseModalCommand}" Background="Transparent" Foreground="#333" BorderBrush="#E0E0E0" BorderThickness="1" Padding="20,8" Margin="0,0,10,0"/>
                        <Button Content="Agregar al Carrito" Command="{Binding  AddWeighedSaleItem}" Background="#1E1E1E"  Foreground="White" BorderBrush="Transparent" Padding="20,8"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
